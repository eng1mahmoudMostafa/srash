# --- Python / Django ---
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
*.py[cod]
backend/staticfiles/
backend/db.sqlite3

# Runtime / secrets — never commit these
.env
.env.local
*.pem

# Local uploads & scratch test output
backend/media/
backend/_*.txt

# --- Node / Vite ---
frontend/node_modules/
frontend/.vite/
# NOTE: frontend/dist/ is deliberately NOT ignored — PythonAnywhere deploys
# straight from git (no npm there), so the built bundles must be committed.
# (A stale ignore rule here once silently dropped a new build from a commit.)

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/