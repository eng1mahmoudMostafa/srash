# .env.example — copy to `.env` in the repo root and fill with real values.
# NEVER commit your real `.env` file (it is git-ignored).

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DB_ENGINE=postgres
DB_NAME=anonymous_app
DB_USER=app
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# --- Cache / Redis ---
CACHE_BACKEND=redis
REDIS_URL=redis://redis:6379/0

# --- Sessions / Cookies ---
# Set COOKIE_SECURE=1 in production (behind HTTPS).
COOKIE_SECURE=0
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- CORS (React dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- App-specific secrets ---
# Generate a real value, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
IP_HMAC_KEY=change-me-random-hex
# Base64 of a 32-byte AES key. Generate with:
# `python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"`
MESSAGE_ENCRYPTION_KEY=change-me

# --- Limits & retention ---
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=20
MAX_MESSAGE_LENGTH=10000
RETENTION_PURGE_DAYS=30

# --- Deployment ---
SITE_BASE_URL=http://localhost:5173
SECURE_HSTS_SECONDS=0
# --- Real e-mail sending (SMTP) ---
# Gmail: enable 2-Step Verification then create an App Password (Mail / Other):
# https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
